# Stage 1: Builder
FROM python:3.12-slim AS builder

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
COPY apps/nexus-api/pyproject.toml apps/nexus-api/
COPY apps/workers/ apps/workers/
COPY packages/ packages/

RUN uv sync --frozen --no-dev

# Pinned impeccable engine: the deterministic UI/UX detector behind the
# `impeccable_detect` tool. Version + sha512 come from
# packages/skills/vendor/impeccable.pin.json; a mismatch fails the build.
COPY scripts/vendor-impeccable.py scripts/vendor-impeccable.py
RUN python scripts/vendor-impeccable.py fetch-engine --dest /opt/impeccable/bin

# Stage 2: Runtime
FROM python:3.12-slim AS runtime

WORKDIR /app

RUN groupadd --gid 1001 appuser && \
    useradd --uid 1001 --gid appuser --shell /bin/sh --create-home appuser

LABEL org.opencontainers.image.source=https://github.com/madfam-org/selva-office

COPY --from=builder /app/.venv /app/.venv
COPY apps/workers/ apps/workers/
COPY packages/ packages/
# Credit-investment backlog + factory-lines roster read by the autopilot.
COPY data/credit-investment/ data/credit-investment/
COPY data/factory-lines/ data/factory-lines/
COPY --from=builder /opt/impeccable /opt/impeccable

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
# impeccable runs with telemetry off, always.
ENV IMPECCABLE_BIN=/opt/impeccable/bin/impeccable \
    IMPECCABLE_NO_TELEMETRY=1 \
    DO_NOT_TRACK=1

USER appuser

CMD ["python", "-m", "selva_workers"]
